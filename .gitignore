node_modules/

# Bundled JS is generated by `npm run build` (esbuild) from src/main.js --
# not source, and Android's own www/ copy under android/app/src/main/
# assets/public is regenerated by `npx cap sync` anyway.
www/main.js

# The APK/OTA-bundle release artifacts uploaded by hand to each restaurant
# server (public/driver-app.apk, public/driver-app-bundle.zip) -- rebuilt
# from source on demand, not checked in here either.
dist/
driver-app-bundle.zip

# Android build output -- regenerated by Gradle every build.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
*.apk
*.aab

# A release-signing keystore would go here once one exists -- never commit
# it (losing it is recoverable by re-signing everything going forward, but
# a leaked one lets anyone impersonate an update to this exact app).
*.keystore
*.jks
